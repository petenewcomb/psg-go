#!/bin/bash

set -e

echo "$0: Entering directory \``pwd`'"
goimports -w .
gofmt -s -w .

find . -type f -name go.mod -print0 | while IFS= read -r -d '' file; do (
    set -e
    cd "${file%/*}"
    echo "$0: Entering directory \``pwd`'"
    set -x
    go mod tidy
    go test -short ./...
    go generate ./...
    go vet ./...
    golangci-lint config verify
    golangci-lint run

    # Explicitly ignoring stdlib modules to work around https://github.com/google/go-licenses/issues/244
    go-licenses check --include_tests $(go-licenses-ignore .) --ignore="$(go list std | awk 'NR > 1 { printf(",") } { printf("%s",$0) } END { print "" }')" ./...

); echo; done

echo "$0: Entering directory \``pwd`'"

set -x
! git status --porcelain -uno | grep '^[^ ][^ ]'
